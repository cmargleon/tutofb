rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /models/{clientId}/{modelId}/poses/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    match /garments/{batchId}/{garmentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    match /garments/drafts/{uid}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAuthenticated() && request.auth.uid == uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    match /generated/{clientId}/{batchId}/{jobId}/{fileName} {
      allow read: if isAuthenticated();
      // Cloud Functions will write these, but we can allow authenticated users if needed for manual uploads
      allow write: if false; 
      allow delete: if isAuthenticated();
    }
  }
}
