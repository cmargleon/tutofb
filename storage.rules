rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentRole() {
      return isAuthenticated() && request.auth.token.role is string
        ? request.auth.token.role
        : null;
    }

    function isActiveUser() {
      return isAuthenticated() && request.auth.token.active == true;
    }

    function isAdmin() {
      return isActiveUser() && currentRole() == 'admin';
    }

    function canGenerate() {
      return isActiveUser() && (currentRole() == 'admin' || currentRole() == 'operador');
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSpreadsheetUpload() {
      return request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.ms-excel'
        );
    }

    match /models/{clientId}/{modelId}/poses/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }

    match /garments/drafts/{uid}/{draftBatchId}/{garmentFile} {
      allow read: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
      allow write: if canGenerate() && request.auth.uid == uid && isImageUpload();
      allow delete: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
    }

    match /garments/drafts/{uid}/{draftBatchId}/{garmentId}/{garmentFile} {
      allow read: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
      allow write: if canGenerate() && request.auth.uid == uid && isImageUpload();
      allow delete: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
    }

    match /generated/{clientId}/{batchId}/{jobId}/{fileName} {
      // Generated outputs must be embeddable and fetchable outside authenticated app sessions.
      allow read: if true;
      allow write: if false;
      allow delete: if isAdmin();
    }

    match /client_spreadsheets/{clientId}/{templateId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if isAdmin() && isSpreadsheetUpload();
      allow delete: if isAdmin();
    }

    match /client_spreadsheet_exports/{clientId}/{batchId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if false;
      allow delete: if isAdmin();
    }

    match /model_generations/{clientId}/{sessionId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if false;
      allow delete: if isAdmin();
    }

    // Newer model-generation flows store assets under
    // model_generations/{clientId}/{modelId}/{stage}/{sessionId}/{fileName}.
    match /model_generations/{clientId}/{modelId}/{stage}/{sessionId}/{fileName} {
      allow read: if isActiveUser();
      allow write: if false;
      allow delete: if isAdmin();
    }
  }
}
