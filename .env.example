VITE_USE_FIREBASE_EMULATORS="true"

# Sentry error monitoring (optional — leave empty to disable)
VITE_SENTRY_DSN=""

# Optional for local Vite HMR behavior
DISABLE_HMR="false"

# Functions runtime secrets are configured with Firebase:
# firebase functions:secrets:set FAL_KEY
# firebase functions:secrets:set OPENAI_API_KEY
# firebase functions:secrets:set GEMINI_API_KEY

# Firebase Functions v2 runtime params:
# BATCH_MAX_JOBS
# JOB_MAX_RETRIES
# JOB_TIMEOUT_MS
# JOB_STUCK_SWEEP_LIMIT
# JOB_RETRY_DELAY_MS
# JOB_AUTO_REVIEW_MAX_ATTEMPTS
# FAL_POLL_INTERVAL_MS
# FAL_POLL_TIMEOUT_MS
# OPENAI_BASE_URL
# GEMINI_IMAGE_REVIEW_MODEL
# GEMINI_POSE_CLASSIFICATION_MODEL
# GEMINI_GARMENT_VIEW_CLASSIFICATION_MODEL

# Shared operational overrides for the app do not live in env vars.
# They are stored in Firestore at system_config/main and managed from /configuracion.
