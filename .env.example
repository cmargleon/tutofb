VITE_USE_FIREBASE_EMULATORS="true"

# Optional for local Vite HMR behavior
DISABLE_HMR="false"

# Functions runtime params / secrets are configured with Firebase:
# firebase functions:secrets:set FAL_KEY
# firebase functions:secrets:set OPENAI_API_KEY
# firebase functions:config:set is not used here; v2 params are read from:
# BATCH_MAX_JOBS
# JOB_MAX_RETRIES
# JOB_TIMEOUT_MS
# JOB_STUCK_SWEEP_LIMIT
# FAL_POLL_INTERVAL_MS
# FAL_POLL_TIMEOUT_MS
# OPENAI_BASE_URL
