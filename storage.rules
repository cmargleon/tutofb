rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Storage cross-service rules support only the default Firestore database.
    // Release verification rejects a configured named database; never fall back to stale claims.
    // The Storage service agent also needs roles/firebaserules.firestoreServiceAgent;
    // scripts/verify-storage-release.mjs verifies that IAM grant before deployment.
    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function currentRole() {
      return userData().role;
    }
    function isActiveUser() {
      return isAuthenticated() && userData().active == true && userData().get('status', 'active') != 'archived';
    }
    function canAccessClient(clientId) {
      return isActiveUser() && (currentRole() in ['admin', 'operador', 'revisor'])
        && (currentRole() == 'admin' || userData().get('clientAccess', {}).get('mode', '') == 'global'
          || (userData().get('clientAccess', {}).get('mode', '') == 'assigned' && clientId in userData().clientAccess.get('clientIds', [])));
    }

    function isAdmin() {
      return isActiveUser() && currentRole() == 'admin';
    }

    function canGenerate() {
      return isActiveUser() && (currentRole() == 'admin' || currentRole() == 'operador');
    }

    function isImageUpload() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSpreadsheetUpload() {
      return request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/vnd.ms-excel'
        );
    }

    match /models/{clientId}/{modelId}/poses/{fileName} {
      allow read: if canAccessClient(firestore.get(/databases/(default)/documents/models/$(modelId)).data.clientId);
      allow write: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }

    match /garments/drafts/{uid}/{draftBatchId}/{garmentFile} {
      allow read: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
      allow write: if canGenerate() && request.auth.uid == uid && isImageUpload();
      allow delete: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
    }

    match /garments/drafts/{uid}/{draftBatchId}/{garmentId}/{garmentFile} {
      allow read: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
      allow write: if canGenerate() && request.auth.uid == uid && isImageUpload();
      allow delete: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
    }

    match /generated/{clientId}/{batchId}/{jobId}/{fileName} {
      allow read: if canAccessClient(clientId);
      allow write: if false;
      allow delete: if isAdmin();
    }

    match /client_spreadsheets/{clientId}/{templateId}/{fileName} {
      allow read: if canAccessClient(clientId);
      allow write: if isAdmin() && isSpreadsheetUpload();
      allow delete: if isAdmin();
    }

    match /wizard_source_spreadsheets/{uid}/{uploadId}/{fileName} {
      allow read: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
      allow write: if canGenerate() && request.auth.uid == uid && isSpreadsheetUpload();
      allow delete: if isAdmin() || (isActiveUser() && request.auth.uid == uid);
    }

    match /client_spreadsheet_exports/{clientId}/{batchId}/{fileName} {
      allow read: if canAccessClient(clientId);
      allow write: if false;
      allow delete: if isAdmin();
    }

    match /model_generations/{clientId}/{sessionId}/{fileName} {
      allow read: if canAccessClient(clientId);
      allow write: if false;
      allow delete: if isAdmin();
    }

    // Newer model-generation flows store assets under
    // model_generations/{clientId}/{modelId}/{stage}/{sessionId}/{fileName}.
    match /model_generations/{clientId}/{modelId}/{stage}/{sessionId}/{fileName} {
      allow read: if canAccessClient(clientId);
      allow write: if false;
      allow delete: if isAdmin();
    }
  }
}
