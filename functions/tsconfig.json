{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@virtual-tryon/shared": ["../shared/src"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
