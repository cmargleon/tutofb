rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(userDocPath());
    }

    function userData() {
      return get(userDocPath()).data;
    }

    function currentRole() {
      return isAuthenticated()
        ? (
            request.auth.token.role is string
              ? request.auth.token.role
              : (hasUserDoc() ? userData().role : null)
          )
        : null;
    }

    function isActiveUser() {
      return isAuthenticated() && hasUserDoc() && userData().active == true;
    }

    function hasRole(role) {
      return isActiveUser() && currentRole() == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function canReview() {
      return isActiveUser() && (currentRole() in ['admin', 'operador', 'revisor']);
    }

    function canReadAnalytics() {
      return isActiveUser() && (currentRole() in ['admin', 'revisor']);
    }

    function canReadFinance() {
      return isAdmin();
    }

    function canUpdateJobSelection() {
      return canReview()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userSelectedOutputId',
          'userSelectedOutput',
          'updatedAt',
        ]);
    }

    function canUpdateJobManualFlag() {
      return canReview()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'manuallyFlagged',
          'manuallyFlaggedAt',
          'manuallyFlaggedByUid',
          'updatedAt',
        ])
        && request.resource.data.manuallyFlagged is bool
        && (
          (request.resource.data.manuallyFlagged == true && request.resource.data.manuallyFlaggedByUid == request.auth.uid)
          || (request.resource.data.manuallyFlagged == false && request.resource.data.manuallyFlaggedByUid == null)
        );
    }

    match /automationJobs/{jobId} {
      allow read: if isAdmin() || (isActiveUser() && currentRole() == 'operador' && resource.data.createdByUid == request.auth.uid);
      allow write: if false;
    }

    match /automationPrincipals/{id} { allow read, write: if false; }
    match /automationAccessTokens/{id} { allow read, write: if false; }

    match /automationKeys/{key} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow create: if isAdmin()
        && request.resource.data.uid == uid
        && request.resource.data.role in ['admin', 'operador', 'revisor'];
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role in ['admin', 'operador', 'revisor'];
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow read: if canReview();
      allow create, update, delete: if isAdmin();

      match /spreadsheetTemplates/{templateId} {
        allow read: if canReview();
        allow create, update, delete: if false;

        match /categories/{categoryId} {
          allow read: if canReview();
          allow create, update, delete: if false;
        }
      }
    }

    match /{path=**}/spreadsheetTemplates/{templateId} {
      allow read: if canReview();
      allow create, update, delete: if false;

      match /categories/{categoryId} {
        allow read: if canReview();
        allow create, update, delete: if false;
      }
    }

    match /models/{modelId} {
      allow read: if canReview();
      allow create, update, delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if canReview();
      allow create, update, delete: if false;

      match /productDrafts/{draftId} {
        allow read: if canReview();
        allow create, update, delete: if false;
      }
    }

    match /jobs/{jobId} {
      allow read: if canReview();
      allow create, delete: if false;
      allow update: if canUpdateJobSelection() || canUpdateJobManualFlag();

      match /outputs/{outputId} {
        allow read: if canReview();
        allow create, update, delete: if false;
      }

      match /logs/{logId} {
        allow read: if canReview();
        allow create, update, delete: if false;
      }
    }

    match /analytics_summary/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /analytics_daily/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /analytics_clients/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /analytics_providers/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /analytics_client_providers/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /analytics_client_models/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /system_alert_settings/{docId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /model_generation_logs/{logId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /analytics_gemini_usage/{logId} {
      allow read: if canReadAnalytics();
      allow write: if false;
    }

    match /system_config/{docId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /finance_settings/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_fx_rates/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_client_pricing/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_fixed_costs/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_events/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_snapshots_global/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_snapshots_clients/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_snapshots_batches/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_snapshots_jobs/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_snapshots_models/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }

    match /finance_snapshots_providers/{docId} {
      allow read: if canReadFinance();
      allow write: if false;
    }
  }
}
