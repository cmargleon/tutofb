rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.role == role) || 
        (getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin') || 
             (request.auth.token.email == "claudiomatiasrg@gmail.com" && request.auth.token.email_verified == true);
    }

    function isOperador() {
      return hasRole('operador');
    }

    function isRevisor() {
      return hasRole('revisor');
    }

    function canWriteData() {
      return isAdmin() || isOperador();
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Users
    // ===============================================================
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && 
                    hasRequiredFields(['uid', 'email', 'role', 'active', 'createdAt', 'updatedAt']) &&
                    request.resource.data.uid == uid &&
                    request.resource.data.role in ['admin', 'operador', 'revisor'];
      allow update: if isAdmin() && 
                    areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
                    request.resource.data.role in ['admin', 'operador', 'revisor'];
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Clients
    // ===============================================================
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if canWriteData() && 
                    hasRequiredFields(['name', 'createdAt', 'updatedAt', 'batchCount', 'createdByUid']) &&
                    validStringLength('name', 1, 100) &&
                    request.resource.data.createdByUid == request.auth.uid &&
                    request.resource.data.batchCount == 0;
      allow update: if canWriteData() && 
                    areImmutableFieldsUnchanged(['createdAt', 'createdByUid']);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Models
    // ===============================================================
    match /models/{modelId} {
      allow read: if isAuthenticated();
      allow create: if canWriteData() && 
                    hasRequiredFields(['clientId', 'clientNameSnapshot', 'name', 'poses', 'poseCount', 'createdAt', 'updatedAt', 'createdByUid']) &&
                    validStringLength('name', 1, 100) &&
                    request.resource.data.createdByUid == request.auth.uid;
      allow update: if canWriteData() && 
                    areImmutableFieldsUnchanged(['clientId', 'createdAt', 'createdByUid']);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Batches
    // ===============================================================
    match /batches/{batchId} {
      allow read: if isAuthenticated();
      // Batches should ideally be created by Cloud Functions to ensure consistency,
      // but if created by client, we allow it for operators/admins.
      allow create: if canWriteData() && 
                    hasRequiredFields(['clientId', 'modelId', 'poseIds', 'garmentCount', 'status', 'createdAt', 'createdByUid']) &&
                    request.resource.data.createdByUid == request.auth.uid;
      allow update: if canWriteData() && 
                    areImmutableFieldsUnchanged(['clientId', 'modelId', 'createdAt', 'createdByUid']);
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Jobs
    // ===============================================================
    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      // Jobs are created by Cloud Functions (createGenerationBatch)
      // But we allow updates for regeneration (status = pending, queuePriority = high)
      allow create: if false; // Only Cloud Functions should create jobs
      allow update: if isAuthenticated() && // Revisor can also regenerate
                    areImmutableFieldsUnchanged(['batchId', 'clientId', 'modelId', 'createdAt', 'createdByUid']) &&
                    request.resource.data.status in ['pending', 'processing', 'completed', 'failed'];
      allow delete: if isAdmin();
      
      match /outputs/{outputId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only Cloud Functions write outputs
      }
      
      match /logs/{logId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only Cloud Functions write logs
      }
    }

    // ===============================================================
    // Analytics
    // ===============================================================
    match /analytics_summary/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }
    match /analytics_daily/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }
    match /analytics_clients/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }
    match /analytics_providers/{docId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Cloud Functions
    }
  }
}
